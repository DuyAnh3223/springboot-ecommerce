# Frontend chạy riêng: sao chép thủ công thành client/.env, rồi khởi động lại Next.js.
# Next.js tự nạp .env tại thư mục client; các biến môi trường của tiến trình ưu tiên hơn.
# Dùng .env.example ở thư mục gốc để cấu hình backend và Docker Compose.

# URL Spring Boot cho service/Server Action, bao gồm context path /abtechzone.
# Chạy trực tiếp: localhost; Docker Compose đã ghi đè thành http://backend:8080/abtechzone.
SPRING_API_URL=http://localhost:8080/abtechzone

# URL public dự phòng cho shared/http/api.ts khi SPRING_API_URL chưa được đặt.
# NEXT_PUBLIC_* có thể xuất hiện trong bundle trình duyệt và được chốt khi build.
# Sau khi đổi URL public của bản production cần build lại frontend.
NEXT_PUBLIC_SPRING_API_URL=http://localhost:8080/abtechzone

# NODE_ENV do lệnh next dev/build/start quản lý; không cần tự đặt.
# Token GHN, JWT, database, AWS và các cổng thanh toán chỉ cấu hình ở backend.
