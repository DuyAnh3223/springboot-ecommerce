# Cấu hình mẫu tập trung cho Spring Boot và Docker Compose.
# Sao chép thủ công thành .env tại thư mục gốc, rồi điền các giá trị còn trống.
# Không có thông tin xác thực thật trong file này.
#
# Docker Compose tự đọc .env để nội suy biến và nạp vào environment của backend.
# Các biến environment khai báo trực tiếp trong Compose được ưu tiên hơn env_file.
# Spring Boot chạy bằng IDE/Maven KHÔNG tự đọc .env: cần nạp các biến vào
# environment của tiến trình backend bằng cấu hình chạy của IDE hoặc shell.
# Với backend chạy trực tiếp trên máy, dùng SPRING_DATASOURCE_* bên dưới
# và đổi REDIS_ADDRESS thành redis://localhost:3308.
# Frontend chạy riêng dùng client/.env.example -> client/.env.

# PostgreSQL của Docker Compose (cổng trên máy: 3307).
# Điền mật khẩu; đồng bộ SPRING_DATASOURCE_PASSWORD khi chạy backend ngoài Docker.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Database cho backend chạy trực tiếp trên máy.
# Compose đã ghi đè 3 biến này bằng host db:5432 và POSTGRES_* ở trên.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:3307/abtechzone
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=
SPRING_PROFILES_ACTIVE=dev

# Redis: địa chỉ bên dưới dành cho backend trong Docker Compose.
# Backend chạy trên máy: redis://localhost:3308.
REDIS_ADDRESS=redis://redis:6379

# JWT HS512: điền chuỗi bí mật ngẫu nhiên dài ít nhất 64 byte.
JWT_SIGNER_KEY=

# CORS: các origin được phép, ngăn cách bằng dấu phẩy.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Mặc định local. Khi dùng profile prod, đặt false để giữ Swagger tắt.
SWAGGER_ENABLED=true

# Khởi tạo admin: chỉ bật khi cần tạo tài khoản admin đầu tiên.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@abtechzone.com

# AWS: cấu hình hiện tại yêu cầu key khi khởi tạo S3 client.
# Điền thông tin tài khoản/bucket của bạn trước khi chạy backend.
AWS_REGION=ap-northeast-1
AWS_BUCKET_NAME=
AWS_BUCKET_ACCESS_KEY=
AWS_BUCKET_SECRET_KEY=

# CloudFront dùng cho ảnh sản phẩm; bắt buộc trong docker-compose.prod.yml.
# PRIVATE_KEY là nội dung khóa PKCS#8 dạng Base64 trên một dòng, không phải đường dẫn.
CLOUDFRONT_URL=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY=

# GHN: backend dùng chung một tài khoản shop để lấy địa chỉ và báo giá.
# Mặc định dùng môi trường test; token, ShopId và địa chỉ lấy hàng phải cùng môi trường.
# Điền TOKEN, SHOP_ID (> 0), FROM_DISTRICT_ID (> 0) và FROM_WARD_CODE hợp lệ.
# Thiếu cấu hình hợp lệ thì dịch vụ địa chỉ/báo giá GHN chưa dùng được.
GHN_SHIPPING_ENABLED=true
GHN_SHIPPING_BASE_URL=https://dev-online-gateway.ghn.vn/shiip/public-api
GHN_SHIPPING_TOKEN=
GHN_SHIPPING_SHOP_ID=0
GHN_SHIPPING_FROM_DISTRICT_ID=0
GHN_SHIPPING_FROM_WARD_CODE=
# Trọng lượng quy ước cho mọi đơn (gram).
GHN_SHIPPING_FIXED_WEIGHT_GRAM=500
GHN_SHIPPING_SERVICE_TYPE_ID=2
GHN_SHIPPING_CONNECT_TIMEOUT_SECONDS=5
GHN_SHIPPING_REQUEST_TIMEOUT_SECONDS=10
GHN_SHIPPING_LOCATION_CACHE_TTL_SECONDS=86400

# Thanh toán: COD dùng được khi các cổng online bên dưới đều tắt.
PAYMENT_MOCK_ENABLED=false
PAYMENT_DEADLINE_MINUTES=15
PAYMENT_MAX_QUERIES=96
PAYMENT_QUERY_WINDOW_HOURS=24
PAYMENT_RETURN_BASE_URL=http://localhost:3000

# MoMo: endpoint hiện tại trong application.yaml là môi trường test.
# Khi bật, điền callback HTTPS public, gồm context path /abtechzone:
# https://<api-domain>/abtechzone/payments/callbacks/momo
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CALLBACK_URL=

# VNPAY: endpoint hiện tại trong application.yaml là sandbox.
# Callback: https://<api-domain>/abtechzone/payments/callbacks/vnpay
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_CALLBACK_URL=

# payOS: cấu hình hiện tại gọi API thật; chỉ bật khi chủ động kiểm thử giao dịch thật.
# Callback: https://<api-domain>/abtechzone/payments/callbacks/payos
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_CALLBACK_URL=

# URL public phục vụ cấu hình frontend của Compose/build image.
# Backend nội bộ của frontend trong Compose đã được đặt qua SPRING_API_URL.
# Không đặt bí mật hoặc token GHN trong biến NEXT_PUBLIC_*.
NEXT_PUBLIC_SPRING_API_URL=http://localhost:8080/abtechzone

# Chỉ cần khi dùng docker-compose.prod.yml; đổi profile thành prod ở phía trên.
# IMAGE_TAG chọn phiên bản image đã được build/push trước đó.
POSTGRES_IMAGE=postgres:15.6-alpine
REDIS_IMAGE=redis:7.4-alpine
DOCKERHUB_USERNAME=
IMAGE_TAG=latest
