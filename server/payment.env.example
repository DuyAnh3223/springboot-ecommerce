# Legacy payment-only reference. Prefer ../.env.example for the full backend configuration.
# Copy values into your local environment; this file contains no credentials.
# MoMo/VNPAY defaults in application.yaml target test/sandbox.
PAYMENT_RETURN_BASE_URL=http://localhost:3000
PAYMENT_DEADLINE_MINUTES=15
PAYMENT_MAX_QUERIES=96
PAYMENT_QUERY_WINDOW_HOURS=24
MOMO_ENABLED=false
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_CALLBACK_URL=https://YOUR_PUBLIC_API/payments/callbacks/momo
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_CALLBACK_URL=https://YOUR_PUBLIC_API/payments/callbacks/vnpay
# payOS has NO sandbox: enabling it reaches production API. Keep false for offline tests.
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_CALLBACK_URL=https://YOUR_PUBLIC_API/payments/callbacks/payos
